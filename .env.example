# KPFU LLM Generator Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://kpfu_user:kpfu_password@localhost:5432/kpfu_generator

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ChromaDB Configuration
CHROMADB_URL=http://localhost:8000

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Model Configuration
LLM_MODEL=gpt-oss:120b-cloud
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Memory Limits (MB)
MAX_LLM_MEMORY=4700
MAX_EMBEDDING_MEMORY=118
MAX_CONTEXT_TOKENS=5000

# Cache Configuration
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE_MB=500

# Performance Configuration
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=300

# File Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx,.xlsx

# Development Configuration
USE_MOCK_SERVICES=false
DEBUG=false
LOG_LEVEL=INFO

# RAG / grounding (facet_rag, chunk_rag)
PIPELINE_MODE=facet_rag
# Retrieval cosine floor per chunk (-1 = off). Start 0.28–0.38 for MiniLM/rubert-tiny2.
CHUNK_RAG_SIMILARITY_THRESHOLD=0.30
CHUNK_RAG_TOP_K_CHUNKS_PER_CONCEPT=6
# Facet section: max unsupported sentence share before regen (0.25 = 75% grounded target).
FACET_SECTION_HALLUCINATION_THRESHOLD=0.25
# hybrid = Jaccard OR embedding cosine (recommended for paraphrased lectures).
FACET_SECTION_HALLUCINATION_GROUNDING_MODE=hybrid
FACET_SECTION_HALLUCINATION_SIMILARITY_MIN=0.07
FACET_SECTION_HALLUCINATION_EMBEDDING_MIN=0.52
FACET_SECTION_HALLUCINATION_MAX_REGENERATIONS=2
# adaptive | evidence_locked | json
FACET_SECTION_HALLUCINATION_REGEN_STRATEGY=adaptive
# Facet outline from RPD §4.2 subtopics (N.M) when theme matches.
FACET_RAG_PREFER_RPD_SUBTOPICS=true
FACET_RAG_RPD_HYBRID_LLM_FILL=true
# Full lecture validation (step3): claim vs page cosine floor.
PACKAGE_VALIDATION_CLAIM_SIMILARITY=0.45

# PPTX presentation (optional; requires PACKAGE_PPTX_ENABLED=true in package run)
PACKAGE_PPTX_ENABLED=true
# Default template: app/presentation/templates/kpfu_ru.pptx (10 × 5.625 in, 16:9)
# PACKAGE_PPTX_TEMPLATE_PATH=
PACKAGE_PPTX_LAYOUT_TITLE=TITLE
PACKAGE_PPTX_LAYOUT_CONTENT=TITLE_AND_BODY
PACKAGE_PPTX_LAYOUT_CONTENT_IMAGE=Два объекта